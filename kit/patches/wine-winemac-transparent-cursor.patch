+/* Hiding the native cursor on macOS 26 and later can synchronize
+ * presentation with cursor movement. Use an invisible cursor for the game
+ * without changing Wine's separate relative movement handling. */
+static BOOL use_transparent_cursor(void)
+{
+    static dispatch_once_t once;
+    static BOOL enabled;
+
+    dispatch_once(&once, ^{
+        if (@available(macOS 26.0, *))
+        {
+            const char *value = getenv("SIL_BO2_TRANSPARENT_CURSOR");
+            enabled = value && !strcmp(value, "1");
+        }
+    });
+    return enabled;
+}
+
+static NSCursor *transparent_cursor(void)
+{
+    static dispatch_once_t once;
+    static NSCursor *cursor;
+
+    dispatch_once(&once, ^{
+        NSImage *image = [[NSImage alloc] initWithSize:NSMakeSize(1, 1)];
+        cursor = [[NSCursor alloc] initWithImage:image hotSpot:NSZeroPoint];
+        [image release];
+    });
+    return cursor;
+}
+
