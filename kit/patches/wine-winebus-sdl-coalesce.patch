+/* Minimum interval, in ms, between input reports queued for one device.
+ * SIL_SDL_REPORT_MS sets it (0 or unset disables it). A 1000 Hz controller
+ * produces one SDL event per axis change, so moving both sticks queued up to
+ * four reports per device report; the report path (raw input message plus the
+ * HID queue) fell behind and the pad state reached the game late. When the
+ * interval has not elapsed the newest state is kept and queued later. */
+static UINT report_interval_ms = 0;
 static const struct bus_options *options;
 
