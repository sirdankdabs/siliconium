+  /**
+  A name given up by a DISCARD map is reused once the GPU has finished the
+  chunk being recorded; a program that maps with DISCARD over and over without
+  submitting any work (no Flush, no Present: Black Ops III Radiant's headless
+  light bake) got a new Metal buffer at nearly every map, without limit. With
+  d3d11.discardRenamesPerFlush = N (0: never), the chunk is committed after N
+  new names, so the old ones retire and are reused.
+  */
+  void
+  ThrottleDiscard(uint64_t &current_seq_id, uint64_t &coherent_seq_id) {
+    if (likely(!discard_renames_per_flush_ || discard_renames_ < discard_renames_per_flush_))
+      return;
+    InvalidateCurrentPass(true);
+    Commit();
+    current_seq_id = cmd_queue.CurrentSeqId();
+    coherent_seq_id = cmd_queue.CoherentSeqId();
+  }
