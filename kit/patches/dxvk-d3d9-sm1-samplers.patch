diff --git a/src/dxso/dxso_util.h b/src/dxso/dxso_util.h
index 097df3f..23db259 100644
--- a/src/dxso/dxso_util.h
+++ b/src/dxso/dxso_util.h
@@ -66,6 +66,23 @@ namespace dxvk {
       + (shaderStage == DxsoProgramType::PixelShader ? caps::MaxTexturesVS : 0);
   }
 
+  // Shaders that do not declare their samplers' types (shader model 1, e.g.
+  // Call of Duty 2's menus) get every variant of each sampler and pick one
+  // with a spec constant. The 3D, cube and cube depth-compare variants shared
+  // the colour and depth bindings, which Metal cannot place either ("undeclared
+  // identifier s0_3dSmplr"): they get their own bindings too, after the depth
+  // ones. The device binds the same image and sampler to all of them; a view
+  // of another type gets DXVK's dummy image, which the shader never samples.
+  constexpr uint32_t SamplerVariantSlotCount = 3;
+
+  constexpr uint32_t computeVariantSlotId(
+        DxsoProgramType shaderStage,
+        uint32_t        bindingIndex,
+        uint32_t        variant) { // 0: 3D, 1: cube, 2: cube depth-compare
+    return computeDepthSlotId(shaderStage, bindingIndex)
+      + (variant + 1) * (caps::MaxTexturesVS + caps::MaxTexturesPS);
+  }
+
   uint32_t RegisterLinkerSlot(DxsoSemantic semantic);
 
 }
