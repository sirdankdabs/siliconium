diff --git a/src/dxso/dxso_util.h b/src/dxso/dxso_util.h
index 3a94acfb..097df3f8 100644
--- a/src/dxso/dxso_util.h
+++ b/src/dxso/dxso_util.h
@@ -53,6 +53,19 @@ namespace dxvk {
     return DxsoConstantBuffers::VSCount + caps::MaxTexturesVS + DxsoConstantBuffers::PSCount + caps::MaxTexturesPS + 1; // From last pixel shader slot, above.
   }
 
+  // The depth-compare ("shadow") variants of a sampler get their own binding,
+  // right after the software vertex processing buffer. On the sampler's own
+  // binding they shared a slot with the colour variants, which SPIR-V allows
+  // but Metal does not: MoltenVK could not place them and the shaders using
+  // that sampler failed to compile. The device binds the same image and
+  // sampler to both slots.
+  constexpr uint32_t computeDepthSlotId(
+        DxsoProgramType shaderStage,
+        uint32_t        bindingIndex) {
+    return getSWVPBufferSlot() + 1 + bindingIndex
+      + (shaderStage == DxsoProgramType::PixelShader ? caps::MaxTexturesVS : 0);
+  }
+
   uint32_t RegisterLinkerSlot(DxsoSemantic semantic);
 
