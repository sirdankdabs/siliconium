+
+/* Siliconium: Steam's web helper (Chromium) draws from a separate GPU process
+ * into a window that belongs to the browser process, which the Mac driver
+ * does not show: every Steam window stays black. Like CrossOver, run its GPU
+ * work in process (and in software). SIL_STEAMWEBHELPER_FIX=0 turns it off. */
+static WCHAR *steamwebhelper_cmdline( const UNICODE_STRING *image, const UNICODE_STRING *cmdline )
+{
+    static const char exe[] = "\\steamwebhelper.exe";
+    static const char args[] = " --no-sandbox --in-process-gpu --disable-gpu";
+    static const char flag[] = "--in-process-gpu";
+    const char *env = getenv( "SIL_STEAMWEBHELPER_FIX" );
+    size_t exe_len = sizeof(exe) - 1, args_len = sizeof(args) - 1, flag_len = sizeof(flag) - 1, len, i, j;
+    const WCHAR *name;
+    WCHAR *ret;
+
+    if (env && env[0] == '0') return NULL;
+    if (!image || !image->Buffer || !cmdline || !cmdline->Buffer) return NULL;
+    len = image->Length / sizeof(WCHAR);
+    if (len < exe_len) return NULL;
+    name = image->Buffer + len - exe_len;
+    for (i = 0; i < exe_len; i++)
+        if (towlower( name[i] ) != (WCHAR)exe[i]) return NULL;
+
+    len = cmdline->Length / sizeof(WCHAR);
+    for (i = 0; i + flag_len <= len; i++)   /* already there */
+    {
+        for (j = 0; j < flag_len && cmdline->Buffer[i + j] == (WCHAR)flag[j]; j++) ;
+        if (j == flag_len) return NULL;
+    }
+    if (!(ret = malloc( (len + args_len + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( ret, cmdline->Buffer, len * sizeof(WCHAR) );
+    for (i = 0; i < args_len; i++) ret[len + i] = (WCHAR)args[i];
+    ret[len + args_len] = 0;
+    return ret;
 }
 
