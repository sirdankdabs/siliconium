+// vertex programs, GLD_FASTDRAW=0) goes the original way.
+//---------------------------------------------------------------------------
+
+static int		s_iFastDraw = -1;		// -1: not read yet
+static GLubyte	s_ubToColour[256];		// gldClampedColour's result for UBYTE_TO_FLOAT(u)
+
+static int _gldFastArraysOK(GLcontext *ctx)
+{
+	const struct gl_array_attrib *a = &ctx->Array;
+	GLuint i;
+
+	if (a->ElementArrayBufferObj && a->ElementArrayBufferObj->Name)
+		return 0;
+	if (ctx->VertexProgram.Enabled)
+		return 0;
+	if (!a->Vertex.Enabled || a->Vertex.Type != GL_FLOAT || a->Vertex.Size < 2 || a->Vertex.Size > 4)
+		return 0;
+	if (a->Color.Enabled && !((a->Color.Type == GL_UNSIGNED_BYTE || a->Color.Type == GL_FLOAT) &&
+			(a->Color.Size == 3 || a->Color.Size == 4)))
+		return 0;
+	if (a->Normal.Enabled && a->Normal.Type != GL_FLOAT)
+		return 0;
+	if (a->Index.Enabled || a->EdgeFlag.Enabled || a->FogCoord.Enabled || a->SecondaryColor.Enabled)
+		return 0;
+	for (i = 0; i < ctx->Const.MaxTextureCoordUnits; i++) {
+		if (!a->TexCoord[i].Enabled)
+			continue;
+		if (i > 1 || a->TexCoord[i].Type != GL_FLOAT || a->TexCoord[i].Size < 1 || a->TexCoord[i].Size > 4)
+			return 0;
+	}
+	return 1;
+}
+
+#define GLD_ARRAY_BASE(arr) ((const GLubyte *)((arr)->BufferObj->Data + (GLuint)(arr)->Ptr))
+
+static __inline void _gldReadTex(GLfloat *d, const GLfloat *s, GLint size)
+{
+	// = _mesa_noop_MultiTexCoord{1,2,3,4}fvARB
+	d[0] = s[0];
+	d[1] = size > 1 ? s[1] : 0.0f;
+	d[2] = size > 2 ? s[2] : 0.0f;
+	d[3] = size > 3 ? s[3] : 1.0f;
+}
+
+static void GLAPIENTRY d3dDrawElementsFast(GLenum mode, GLsizei count, GLenum type, const GLvoid *indices)
+{
+	{ extern int gldTraceThisFrame;
+	  if (gldTraceThisFrame) { GET_CURRENT_CONTEXT(tctx);
+		gldLogPrintf(GLDLOG_SYSTEM, "FR drawelements mode=%d count=%d tex=%d en=0x%x", mode, count,
+			tctx->Texture.Unit[0]._Current ? (int)tctx->Texture.Unit[0]._Current->Name : -1, tctx->Texture._EnabledUnits); } }
+	GET_CURRENT_CONTEXT(ctx);
+	GLD_context		*gldCtx	= GLD_GET_CONTEXT(ctx);
+	GLD_driver_dx9	*gld	= GLD_GET_DX9_DRIVER(gldCtx);
+	const struct gl_array_attrib *a = &ctx->Array;
+	const GLubyte	*pV = NULL, *pC = NULL, *pN = NULL, *pT0 = NULL, *pT1 = NULL;
+	GLsizei			sV = 0, sC = 0, sN = 0, sT0 = 0, sT1 = 0;
+	GLint			nV, nC = 0, nT0 = 0, nT1 = 0;
+	GLboolean		bCUb = GL_FALSE;
+	GLfloat			cur[4], t0[4], t1[4], nrm[4];
+	D3DCOLOR		dwCurColour;
+	GLuint			elt = 0;
+	GLsizei			i;
+	GLD_4D_VERTEX	*pDst;
+
+	if (s_iFastDraw < 0) {
+		const char *e = getenv("GLD_FASTDRAW");
+		GLfloat c[4];
+		int k;
+		s_iFastDraw = (e && e[0] == '0') ? 0 : 1;
+		for (k = 0; k < 256; k++) {
+			c[0] = c[1] = c[2] = c[3] = UBYTE_TO_FLOAT(k);
+			s_ubToColour[k] = (GLubyte)(gldClampedColour(c) & 0xff);
+		}
+		gldLogPrintf(GLDLOG_INFO, "Fast DrawElements: %s", s_iFastDraw ? "on" : "off (GLD_FASTDRAW=0)");
+	}
+
+	if (!s_iFastDraw || mode != GL_TRIANGLES || !_gldFastArraysOK(ctx)) {
+		_mesa_noop_DrawElements(mode, count, type, indices);
+		return;
+	}
+
+	if (!_mesa_validate_DrawElements(ctx, mode, count, type, indices))
+		return;
+
+	d3dBegin(mode);
+	if (ctx->Driver.CurrentExecPrimitive != mode)
+		return; // glBegin failed (already recorded the error)
+
+	while (gld->dwPrimVert + (DWORD)count > gld->dwMaxPrimVerts)
+		_gldEnlargePrimitiveBuffer(gld);
+
+	// Current values for attributes without an array (as d3dVertex4f reads them)
+	COPY_4V(t0, ctx->Current.Attrib[VERT_ATTRIB_TEX0]);
+	COPY_4V(t1, ctx->Current.Attrib[VERT_ATTRIB_TEX1]);
+	COPY_4V(nrm, ctx->Current.Attrib[VERT_ATTRIB_NORMAL]);
+	COPY_4V(cur, ctx->Current.Attrib[VERT_ATTRIB_COLOR0]);
+	dwCurColour = gldClampedColour(cur);
+
+	nV = a->Vertex.Size; pV = GLD_ARRAY_BASE(&a->Vertex); sV = a->Vertex.StrideB;
+	if (a->Color.Enabled) {
+		nC = a->Color.Size; pC = GLD_ARRAY_BASE(&a->Color); sC = a->Color.StrideB;
+		bCUb = (a->Color.Type == GL_UNSIGNED_BYTE);
+	}
+	if (a->Normal.Enabled) { pN = GLD_ARRAY_BASE(&a->Normal); sN = a->Normal.StrideB; }
+	if (a->TexCoord[0].Enabled) { nT0 = a->TexCoord[0].Size; pT0 = GLD_ARRAY_BASE(&a->TexCoord[0]); sT0 = a->TexCoord[0].StrideB; }
+	if (ctx->Const.MaxTextureCoordUnits > 1 && a->TexCoord[1].Enabled) {
+		nT1 = a->TexCoord[1].Size; pT1 = GLD_ARRAY_BASE(&a->TexCoord[1]); sT1 = a->TexCoord[1].StrideB;
+	}
+
+	pDst = &gld->pPrim[gld->dwPrimVert];
+	for (i = 0; i < count; i++, pDst++) {
+		const GLfloat *v;
+		switch (type) {
+		case GL_UNSIGNED_SHORT:	elt = ((const GLushort *)indices)[i]; break;
+		case GL_UNSIGNED_INT:	elt = ((const GLuint *)indices)[i]; break;
+		default:				elt = ((const GLubyte *)indices)[i]; break;
+		}
+		if (pT0) _gldReadTex(t0, (const GLfloat *)(pT0 + elt * sT0), nT0);
+		if (pT1) _gldReadTex(t1, (const GLfloat *)(pT1 + elt * sT1), nT1);
+		if (pC) {
+			if (bCUb) {
+				const GLubyte *c = pC + elt * sC;
+				pDst->Diffuse = D3DCOLOR_RGBA(s_ubToColour[c[0]], s_ubToColour[c[1]], s_ubToColour[c[2]],
+					nC == 4 ? s_ubToColour[c[3]] : s_ubToColour[255]);
+			} else {
+				const GLfloat *c = (const GLfloat *)(pC + elt * sC);
+				cur[0] = c[0]; cur[1] = c[1]; cur[2] = c[2]; cur[3] = (nC == 4) ? c[3] : 1.0f;
+				pDst->Diffuse = gldClampedColour(cur);
+			}
+		} else {
+			pDst->Diffuse = dwCurColour;
+		}
+		if (pN) {
+			v = (const GLfloat *)(pN + elt * sN);
+			nrm[0] = v[0]; nrm[1] = v[1]; nrm[2] = v[2];
+		}
+		v = (const GLfloat *)(pV + elt * sV);
+		pDst->Position.x	= v[0];
+		pDst->Position.y	= v[1] - gld->fViewportY;
+		pDst->Position.z	= nV > 2 ? v[2] : 0.0f;
+		pDst->Position.w	= nV > 3 ? v[3] : 1.0f;
+		pDst->Tex0.x		= t0[0];
+		pDst->Tex0.y		= t0[1];
+		pDst->Tex0.z		= t0[2];
+		pDst->Tex0.w		= t0[3];
+		pDst->Tex1.x		= t1[0];
+		pDst->Tex1.y		= t1[1];
+		pDst->Tex1.z		= t1[2];
+		pDst->Tex1.w		= t1[3];
+		pDst->Normal.x		= nrm[0];
+		pDst->Normal.y		= nrm[1];
+		pDst->Normal.z		= nrm[2];
+	}
+	gld->dwPrimVert += count;
+
+	// Same side effects as the per-vertex calls: the current attributes are
+	// the last element's
+	if (pT0) COPY_4V(ctx->Current.Attrib[VERT_ATTRIB_TEX0], t0);
+	if (pT1) COPY_4V(ctx->Current.Attrib[VERT_ATTRIB_TEX1], t1);
+	if (pN) { ctx->Current.Attrib[VERT_ATTRIB_NORMAL][0] = nrm[0]; ctx->Current.Attrib[VERT_ATTRIB_NORMAL][1] = nrm[1];
+		ctx->Current.Attrib[VERT_ATTRIB_NORMAL][2] = nrm[2]; ctx->Current.Attrib[VERT_ATTRIB_NORMAL][3] = 1.0f; }
+	if (pC) {
+		GLfloat *dc = ctx->Current.Attrib[VERT_ATTRIB_COLOR0];
+		if (bCUb) {
+			const GLubyte *c = pC + elt * sC;
+			dc[0] = UBYTE_TO_FLOAT(c[0]); dc[1] = UBYTE_TO_FLOAT(c[1]); dc[2] = UBYTE_TO_FLOAT(c[2]);
+			dc[3] = nC == 4 ? UBYTE_TO_FLOAT(c[3]) : 1.0f;
+		} else {
+			COPY_4V(dc, cur);
+		}
+	}
+
+	d3dEnd();
+}
+
