+//---------------------------------------------------------------------------
+// Siliconium: asynchronous effect compiles (GLD_ASYNC_EFFECTS=1, needs
+// GLD_SHADER_CACHE). A state met for the first time used to be compiled on
+// the game thread (10-170 ms each, the hitches when a new area or light
+// combination appears). Now an effect whose binary is not in the cache is
+// compiled by one worker thread (D3DCompile + the .fxo file; no Direct3D
+// calls there); its draws are skipped until the game thread finds the job
+// done and builds the effect from the binary (~1 ms).
+//---------------------------------------------------------------------------
+
+typedef struct {
+	char				*pszText;
+	char				szPath[MAX_PATH];
+	DWORD				dwFlags;
+	GLD_effect_state	State;
+	void				*pData;		// fx_2_0 binary (NULL: failed)
+	DWORD				dwSize;
+	volatile LONG		lDone;
+} GLD_effect_job;
+
+#define GLD_JOB_QUEUE 4096
+static GLD_effect_job		*gldJobQueue[GLD_JOB_QUEUE];
+static volatile LONG		gldJobHead, gldJobTail;
+static CRITICAL_SECTION		gldJobLock;
+static HANDLE				gldJobEvent, gldJobThread;
+
+static int _gldAsyncEnabled(void)
+{
+	static int on = -1;
+	if (on < 0) {
+		const char *v = getenv("GLD_ASYNC_EFFECTS"), *d = getenv("GLD_SHADER_CACHE");
+		on = v && atoi(v) > 0 && d && *d;
+	}
+	return on;
+}
+
+static GLD_PFN_D3DCOMPILE _gldGetCompiler(void)
+{
+	static GLD_PFN_D3DCOMPILE pCompile = NULL;
+	static volatile LONG lTried = 0;
+	if (!InterlockedExchange(&lTried, 1)) {
+		HMODULE hMod = LoadLibraryA("d3dcompiler_43.dll");
+		if (hMod)
+			pCompile = (GLD_PFN_D3DCOMPILE)GetProcAddress(hMod, "D3DCompile");
+	}
+	return pCompile;
+}
+
+static void _gldWriteFileAtomic(const char *pszPath, const void *pData, DWORD dwSize)
+{
+	char szTmp[MAX_PATH + 16];
+	HANDLE hFile;
+	DWORD dwWritten = 0;
+	BOOL bOk;
+	_snprintf(szTmp, sizeof(szTmp), "%s.%lu", pszPath, GetCurrentProcessId());
+	szTmp[sizeof(szTmp) - 1] = 0;
+	hFile = CreateFileA(szTmp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+	if (hFile == INVALID_HANDLE_VALUE)
+		return;
+	bOk = WriteFile(hFile, pData, dwSize, &dwWritten, NULL) && dwWritten == dwSize;
+	CloseHandle(hFile);
+	if (!bOk || !MoveFileExA(szTmp, pszPath, MOVEFILE_REPLACE_EXISTING))
+		DeleteFileA(szTmp);
+}
+
+static DWORD WINAPI _gldJobWorker(LPVOID p)
+{
+	for (;;) {
+		GLD_effect_job *job = NULL;
+		WaitForSingleObject(gldJobEvent, INFINITE);
+		for (;;) {
+			EnterCriticalSection(&gldJobLock);
+			if (gldJobHead != gldJobTail) {
+				job = gldJobQueue[gldJobHead % GLD_JOB_QUEUE];
+				gldJobHead++;
+			} else {
+				job = NULL;
+			}
+			LeaveCriticalSection(&gldJobLock);
+			if (!job)
+				break;
+			{
+				GLD_PFN_D3DCOMPILE pCompile = _gldGetCompiler();
+				ID3D10Blob *pCode = NULL, *pErr = NULL;
+				HRESULT hr = pCompile ? pCompile(job->pszText, strlen(job->pszText), NULL, NULL, NULL, NULL,
+					"fx_2_0", job->dwFlags, 0, &pCode, &pErr) : E_FAIL;
+				if (pErr) ID3D10Blob_Release(pErr);
+				if (SUCCEEDED(hr) && pCode) {
+					DWORD n = (DWORD)ID3D10Blob_GetBufferSize(pCode);
+					void *d = malloc(n);
+					if (d) {
+						memcpy(d, ID3D10Blob_GetBufferPointer(pCode), n);
+						_gldWriteFileAtomic(job->szPath, d, n);
+						if (getenv("GLD_EFFECT_DUMP")) {
+							char sz[MAX_PATH + 8];
+							_snprintf(sz, sizeof(sz), "%s.fx", job->szPath); sz[sizeof(sz) - 1] = 0;
+							_gldWriteFileAtomic(sz, job->pszText, (DWORD)strlen(job->pszText));
+							_snprintf(sz, sizeof(sz), "%s.st", job->szPath); sz[sizeof(sz) - 1] = 0;
+							_gldWriteFileAtomic(sz, &job->State, sizeof(job->State));
+						}
+						job->pData = d;
+						job->dwSize = n;
+					}
+				}
+				if (pCode) ID3D10Blob_Release(pCode);
+			}
+			InterlockedExchange(&job->lDone, 1);
+		}
+	}
+	return 0;
+}
+
+static BOOL _gldQueueJob(GLD_effect_job *job)
+{
+	BOOL bOk = FALSE;
+	if (!gldJobThread) {
+		InitializeCriticalSection(&gldJobLock);
+		gldJobEvent = CreateEventA(NULL, FALSE, FALSE, NULL);
+		gldJobThread = CreateThread(NULL, 0, _gldJobWorker, NULL, 0, NULL);
+		if (gldJobThread)
+			SetThreadPriority(gldJobThread, THREAD_PRIORITY_BELOW_NORMAL);
+	}
+	if (!gldJobThread || !gldJobEvent)
+		return FALSE;
+	EnterCriticalSection(&gldJobLock);
+	if (gldJobTail - gldJobHead < GLD_JOB_QUEUE) {
+		gldJobQueue[gldJobTail % GLD_JOB_QUEUE] = job;
+		gldJobTail++;
+		bOk = TRUE;
+	}
+	LeaveCriticalSection(&gldJobLock);
+	if (bOk)
+		SetEvent(gldJobEvent);
+	return bOk;
+}
+
+static int _gldFinishEffect(GLD_driver_dx9 *gld, GLD_effect *pGLDEffect, HRESULT hr, DWORD dwFlags);
+
+// The game thread: a finished job becomes the effect (call before using it)
+static void _gldPollJob(GLD_driver_dx9 *gld, GLD_effect *pGLDEffect)
+{
+	GLD_effect_job *job = (GLD_effect_job *)pGLDEffect->pJob;
+	HRESULT hr = E_FAIL;
+	if (!job || !job->lDone)
+		return;
+	pGLDEffect->pJob = NULL;
+	if (job->pData)
+		hr = D3DXCreateEffect(gld->pDev, job->pData, job->dwSize, NULL, NULL, pGLDEffect->dwFlags,
+			gld->pEffectPool, &pGLDEffect->pEffect, NULL);
+	if (FAILED(hr))
+		gldLogPrintf(GLDLOG_WARN, "Async effect failed (hr=0x%08x); default effect used", (unsigned)hr);
+	_gldFinishEffect(gld, pGLDEffect, hr, pGLDEffect->dwFlags);
+	free(job->pData);
+	free(job->pszText);
+	free(job);
+}
+
+// Waits for every job of this context (before its effects are released)
+static void _gldWaitJobs(GLD_driver_dx9 *gld)
+{
+	int i, n;
+	for (i=0; i<gld->nEffects; i++) {
+		GLD_effect_job *job = (GLD_effect_job *)gld->Effects[i].pJob;
+		if (!job) continue;
+		for (n=0; n<500 && !job->lDone; n++) Sleep(10);
+		if (job->lDone) { free(job->pData); free(job->pszText); free(job); }
+		gld->Effects[i].pJob = NULL;	// (a job still running after 5 s is leaked, not freed under the worker)
+	}
+}
