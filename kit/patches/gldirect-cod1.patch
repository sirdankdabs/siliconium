diff --git a/src/gld_prof.c b/src/gld_prof.c
new file mode 100644
index 0000000..be4245d
--- /dev/null
+++ b/src/gld_prof.c
@@ -0,0 +1,97 @@
+/*
+ * Siliconium: in-process sampling profiler (diagnostics only, off unless
+ * GLD_PROFILE="<start s>,<duration s>" is set). macOS tools cannot unwind
+ * Rosetta-translated code, so this thread suspends the GL thread every ~1 ms,
+ * reads its EIP and, at the end, writes "count module+offset" lines (plus a
+ * per-module summary) to GLD_PROFILE_OUT (default gldprof.txt).
+ */
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define GLDPROF_MAX 400000
+static DWORD *s_eip;
+static HANDLE s_target;
+static volatile LONG s_started;
+
+typedef struct { DWORD eip; DWORD n; } eipcount;
+static int cmp_eip(const void *a, const void *b) { DWORD x = *(const DWORD *)a, y = *(const DWORD *)b; return x < y ? -1 : x > y; }
+static int cmp_n(const void *a, const void *b) { return ((const eipcount *)b)->n - ((const eipcount *)a)->n; }
+
+static void modname(DWORD eip, char *out, size_t sz, DWORD *off)
+{
+	HMODULE h = NULL;
+	char path[MAX_PATH], *p;
+	*off = eip;
+	if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+			(LPCSTR)(ULONG_PTR)eip, &h) && h && GetModuleFileNameA(h, path, sizeof(path))) {
+		p = strrchr(path, '\\');
+		_snprintf(out, sz, "%s", p ? p + 1 : path);
+		*off = eip - (DWORD)(ULONG_PTR)h;
+	} else {
+		_snprintf(out, sz, "?");
+	}
+	out[sz - 1] = 0;
+}
+
+static DWORD WINAPI sampler(LPVOID arg)
+{
+	const char *cfg = getenv("GLD_PROFILE"), *outp = getenv("GLD_PROFILE_OUT");
+	int start = 10, dur = 10, n = 0, i, nu = 0, nm = 0;
+	DWORD t0;
+	eipcount *u;
+	struct { char name[64]; DWORD n; } mods[64];
+	FILE *f;
+	sscanf(cfg, "%d,%d", &start, &dur);
+	timeBeginPeriod(1);
+	Sleep(start * 1000);
+	t0 = GetTickCount();
+	while (GetTickCount() - t0 < (DWORD)dur * 1000 && n < GLDPROF_MAX) {
+		CONTEXT c;
+		if (SuspendThread(s_target) == (DWORD)-1) break;
+		c.ContextFlags = CONTEXT_CONTROL;
+		if (GetThreadContext(s_target, &c)) s_eip[n++] = c.Eip;
+		ResumeThread(s_target);
+		Sleep(1);
+	}
+	timeEndPeriod(1);
+	qsort(s_eip, n, sizeof(DWORD), cmp_eip);
+	u = (eipcount *)malloc(sizeof(eipcount) * (n + 1));
+	for (i = 0; i < n; i++) {
+		if (nu && u[nu - 1].eip == s_eip[i]) u[nu - 1].n++;
+		else { u[nu].eip = s_eip[i]; u[nu].n = 1; nu++; }
+	}
+	for (i = 0; i < nu; i++) {
+		char m[64]; DWORD off; int k;
+		modname(u[i].eip, m, sizeof(m), &off);
+		for (k = 0; k < nm && strcmp(mods[k].name, m); k++) ;
+		if (k == nm && nm < 64) { strcpy(mods[nm].name, m); mods[nm].n = 0; nm++; }
+		if (k < nm) mods[k].n += u[i].n;
+	}
+	qsort(u, nu, sizeof(eipcount), cmp_n);
+	f = fopen(outp && *outp ? outp : "gldprof.txt", "w");
+	if (f) {
+		fprintf(f, "samples %d over %d s\n", n, dur);
+		for (i = 0; i < nm; i++) fprintf(f, "MOD %7lu %5.1f%% %s\n", mods[i].n, 100.0 * mods[i].n / (n ? n : 1), mods[i].name);
+		for (i = 0; i < nu && i < 3000; i++) {
+			char m[64]; DWORD off;
+			modname(u[i].eip, m, sizeof(m), &off);
+			fprintf(f, "EIP %6lu %s+0x%lx\n", u[i].n, m, off);
+		}
+		fclose(f);
+	}
+	free(u);
+	return 0;
+}
+
+void gldProfileStart(void)
