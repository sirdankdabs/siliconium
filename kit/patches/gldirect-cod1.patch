+static int _gldEffectCachePath(GLD_driver_dx9 *gld, const GLD_effect_state *pState, DWORD dwAlphaTest, DWORD dwFlags,
+	const char *pszDir, char *szPath)
+{
+	unsigned long long h;
+	if (!pszDir || !*pszDir)
+		return 0;
+	h = _gldFnv(0xcbf29ce484222325ULL, pState, sizeof(*pState));
+	// Generator id: change it whenever the generated HLSL text or GLD_effect_state changes
+	// (was the build date/time, so every rebuild threw the cache away)
+#define GLD_SHADER_GEN_ID "siliconium-s11-samplers-1"
+	h = _gldFnv(h, GLD_SHADER_GEN_ID, sizeof(GLD_SHADER_GEN_ID));
+	h = _gldFnv(h, &gld->d3dCaps9.VertexShaderVersion, sizeof(DWORD));
+	h = _gldFnv(h, &gld->d3dCaps9.PixelShaderVersion, sizeof(DWORD));
+	h = _gldFnv(h, &dwFlags, sizeof(dwFlags));
+	// Siliconium: effects with the alpha test in the pixel shader have their
+	// own files (the others keep the names they had)
+	if (dwAlphaTest)
+		h = _gldFnv(h, "siliconium-s19-alphatest-clip-1", sizeof("siliconium-s19-alphatest-clip-1"));
+	if (pState->Fog.Enabled && gldShaderFog())
+		h = _gldFnv(h, "siliconium-s19-psfog-1", sizeof("siliconium-s19-psfog-1"));
+	_snprintf(szPath, MAX_PATH, "%s\\%016llx.fxo", pszDir, h);
+	szPath[MAX_PATH - 1] = 0;
+	return 1;
+}
