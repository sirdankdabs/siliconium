+static HRESULT _gldCreateEffectCached(
+	GLD_driver_dx9 *gld,
+	const GLD_effect_state *pState,
+	DWORD dwAlphaTest,
+	const char *pszEffect,
+	DWORD dwFlags,
+	ID3DXEffect **ppEffect,
+	ID3DXBuffer **ppErrors)
+{
+	static GLD_PFN_D3DCOMPILE pCompile = NULL;
+	static int iTried = 0;
+	const char *pszDir = getenv("GLD_SHADER_CACHE");
+	char szPath[MAX_PATH];
+	unsigned long long h;
+	HANDLE hFile;
+	HRESULT hr;
+
+	{ static int once; if (!once) { once = 1; gldLogPrintf(GLDLOG_INFO, "Effect cache: %s", pszDir ? pszDir : "(off)"); } }
+	if (!pszDir || !*pszDir)
+		goto from_text;
+	if (!_gldEffectCachePath(gld, pState, dwAlphaTest, dwFlags, pszDir, szPath))
+		goto from_text;
+
+	// Cached binary?
+	hFile = CreateFileA(szPath, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+	if (hFile != INVALID_HANDLE_VALUE) {
+		DWORD dwSize = GetFileSize(hFile, NULL), dwRead = 0;
+		void *pData = (dwSize && dwSize != INVALID_FILE_SIZE) ? malloc(dwSize) : NULL;
+		BOOL bOk = pData && ReadFile(hFile, pData, dwSize, &dwRead, NULL) && dwRead == dwSize;
+		CloseHandle(hFile);
+		if (bOk) {
+			hr = D3DXCreateEffect(gld->pDev, pData, dwSize, NULL, NULL, dwFlags, gld->pEffectPool, ppEffect, NULL);
+			free(pData);
+			if (SUCCEEDED(hr))
+				return hr;
+		} else if (pData) {
+			free(pData);
+		}
+	}
+
+	// Compile to fx_2_0 binary, keep it, build the effect from it
+	if (!iTried) {
+		HMODULE hMod = LoadLibraryA("d3dcompiler_43.dll");
+		iTried = 1;
+		if (hMod)
+			pCompile = (GLD_PFN_D3DCOMPILE)GetProcAddress(hMod, "D3DCompile");
+	}
+	if (pCompile) {
+		ID3D10Blob *pCode = NULL, *pErr = NULL;
+		hr = pCompile(pszEffect, strlen(pszEffect), NULL, NULL, NULL, NULL, "fx_2_0", dwFlags, 0, &pCode, &pErr);
+		if (FAILED(hr))
+			gldLogPrintf(GLDLOG_WARN, "Effect cache: D3DCompile fx_2_0 hr=0x%08x %s", (unsigned)hr,
+				pErr ? (const char *)ID3D10Blob_GetBufferPointer(pErr) : "");
+		if (pErr) ID3D10Blob_Release(pErr);
+		if (SUCCEEDED(hr) && pCode) {
+			const void *pData = ID3D10Blob_GetBufferPointer(pCode);
+			DWORD dwSize = (DWORD)ID3D10Blob_GetBufferSize(pCode), dwWritten = 0;
+			hr = D3DXCreateEffect(gld->pDev, pData, dwSize, NULL, NULL, dwFlags, gld->pEffectPool, ppEffect, NULL);
+			if (FAILED(hr))
+				gldLogPrintf(GLDLOG_WARN, "Effect cache: CreateEffect from fx_2_0 binary hr=0x%08x", (unsigned)hr);
+			if (SUCCEEDED(hr)) {
+				char szTmp[MAX_PATH + 8];
+				CreateDirectoryA(pszDir, NULL);
+				_snprintf(szTmp, sizeof(szTmp), "%s.%lu", szPath, GetCurrentProcessId());
+				szTmp[sizeof(szTmp) - 1] = 0;
+				hFile = CreateFileA(szTmp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+				if (hFile != INVALID_HANDLE_VALUE) {
+					BOOL bOk = WriteFile(hFile, pData, dwSize, &dwWritten, NULL) && dwWritten == dwSize;
+					CloseHandle(hFile);
+					if (!bOk || !MoveFileExA(szTmp, szPath, MOVEFILE_REPLACE_EXISTING))
+						DeleteFileA(szTmp);
+				}
+				// GLD_EFFECT_DUMP=1 (diagnostics): the HLSL text (.fx) and the raw key state
+				// (.st) of every newly compiled effect, next to its .fxo
+				if (getenv("GLD_EFFECT_DUMP")) {
+					DWORD dw;
+					_snprintf(szTmp, sizeof(szTmp), "%s.fx", szPath); szTmp[sizeof(szTmp) - 1] = 0;
+					hFile = CreateFileA(szTmp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+					if (hFile != INVALID_HANDLE_VALUE) { WriteFile(hFile, pszEffect, (DWORD)strlen(pszEffect), &dw, NULL); CloseHandle(hFile); }
+					_snprintf(szTmp, sizeof(szTmp), "%s.st", szPath); szTmp[sizeof(szTmp) - 1] = 0;
+					hFile = CreateFileA(szTmp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+					if (hFile != INVALID_HANDLE_VALUE) { WriteFile(hFile, pState, sizeof(*pState), &dw, NULL); CloseHandle(hFile); }
+				}
+				ID3D10Blob_Release(pCode);
+				return hr;
+			}
+			ID3D10Blob_Release(pCode);
+		}
+	}
+
+from_text:
+	return D3DXCreateEffect(gld->pDev, pszEffect, strlen(pszEffect), NULL, NULL,
+		dwFlags, gld->pEffectPool, ppEffect, ppErrors);
+}
