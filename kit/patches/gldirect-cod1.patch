+//---------------------------------------------------------------------------
+// Compiled-effect cache (Siliconium). Building an effect from HLSL text
+// compiles it (~110 ms each under Wine: 59 effects = 6.5 s of hitches in
+// Call of Duty's timedemo). With GLD_SHADER_CACHE=<folder> the compiled
+// fx_2_0 binary of each effect is kept there, named by a hash of the GL
+// state it was built from (+ this build's date, so a new build never reads
+// another build's effects), and loaded directly the next time.
+//---------------------------------------------------------------------------
+
+typedef HRESULT (WINAPI *GLD_PFN_D3DCOMPILE)(const void *, SIZE_T, const char *,
+	const void *, void *, const char *, const char *, UINT, UINT, ID3D10Blob **, ID3D10Blob **);
+
+static unsigned long long _gldFnv(unsigned long long h, const void *p, size_t n)
+{
+	const unsigned char *b = (const unsigned char *)p;
+	while (n--) { h ^= *b++; h *= 0x100000001b3ULL; }
+	return h;
+}
+
+// Siliconium: the cache file of an effect state (see GLD_SHADER_GEN_ID)
+//---------------------------------------------------------------------------
+// Siliconium: the GL alpha test (glAlphaFunc NEVER/LESS/LEQUAL/GREATER/GEQUAL)
+// is done in the pixel shader (clip) instead of by the Direct3D alpha test
+// render state. Through DXVK and MoltenVK the device alpha test of these
+// effects kept LESS 0.5 from ever passing and GEQUAL 0.5 from ever failing
+// (Call of Duty: United Offensive, Bastogne: pine branches missing, treeline
+// cards opaque); with clip() they draw as with Apple's OpenGL.
+// Effects without alpha test are unchanged (same text, same cache file).
+// GLD_SHADER_ALPHATEST=0: the device alpha test as before.
+//---------------------------------------------------------------------------
+BOOL gldShaderAlphaTest(void)
+{
+	static int on = -1;
+	if (on < 0) {
+		const char *v = getenv("GLD_SHADER_ALPHATEST");
+		on = !(v && *v == '0');
+		gldLogPrintf(GLDLOG_INFO, "Alpha test: %s", on ? "pixel shader" : "device (GLD_SHADER_ALPHATEST=0)");
+	}
+	return on;
+}
+
+//---------------------------------------------------------------------------
+// Siliconium: GL fog blended in the pixel shader (the factor is computed per
+// vertex as before) instead of by Direct3D's fog stage: through DXVK and
+// MoltenVK distant geometry got much less fog than with Apple's OpenGL
+// (United Offensive, Bastogne: far trees dark instead of fading to the fog
+// colour). GLD_SHADER_FOG=0: the device fog as before.
+//---------------------------------------------------------------------------
+BOOL gldShaderFog(void)
+{
+	static int on = -1;
+	if (on < 0) {
+		const char *v = getenv("GLD_SHADER_FOG");
+		on = !(v && *v == '0');
+		gldLogPrintf(GLDLOG_INFO, "Fog: %s", on ? "pixel shader" : "device (GLD_SHADER_FOG=0)");
+	}
+	return on;
+}
+
+// 1 when the current GL alpha test goes into the effect
+static DWORD _gldAlphaTestKey(const GLcontext *ctx)
+{
+	if (!ctx->Color.AlphaEnabled || !gldShaderAlphaTest())
+		return 0;
+	switch (ctx->Color.AlphaFunc) {
+	case GL_NEVER: case GL_LESS: case GL_LEQUAL: case GL_GREATER: case GL_GEQUAL:
+		return 1;
+	}
+	return 0; // ALWAYS: nothing to test; EQUAL/NOTEQUAL: device alpha test
+}
+
+// clip(Color.a * x + y) keeps the fragment when the GL alpha test passes
+static void _gldAlphaTestVector(const GLcontext *ctx, D3DXVECTOR4 *v)
+{
+	const float r = ctx->Color.AlphaRef, e = 1.0f / 1024.0f;	// e: strict comparisons
+	v->x = 0.0f; v->y = 1.0f; v->z = 0.0f; v->w = 0.0f;
+	switch (ctx->Color.AlphaFunc) {
+	case GL_NEVER:		v->x = 0.0f;	v->y = -1.0f;	break;
+	case GL_LESS:		v->x = -1.0f;	v->y = r - e;	break;	// a <  r
+	case GL_LEQUAL:		v->x = -1.0f;	v->y = r;		break;	// a <= r
+	case GL_GREATER:	v->x = 1.0f;	v->y = -r - e;	break;	// a >  r
+	case GL_GEQUAL:		v->x = 1.0f;	v->y = -r;		break;	// a >= r
+	}
+}
