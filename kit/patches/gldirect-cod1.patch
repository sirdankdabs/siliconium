+//---------------------------------------------------------------------------
+// GL_ARB_texture_compression + GL_EXT_texture_compression_s3tc:
+// S3TC DXT1/3/5 blocks are Direct3D's DXT1/3/5 blocks, copied as they are.
+//---------------------------------------------------------------------------
+
+static D3DFORMAT _gldS3TCFormat(
+	GLenum internalFormat,
+	const struct gl_texture_format **mesaFormat)
+{
+	switch (internalFormat) {
+	case GL_COMPRESSED_RGB_S3TC_DXT1_EXT:
+		*mesaFormat = &_mesa_texformat_rgb_dxt1;
+		return D3DFMT_DXT1;
+	case GL_COMPRESSED_RGBA_S3TC_DXT1_EXT:
+		*mesaFormat = &_mesa_texformat_rgba_dxt1;
+		return D3DFMT_DXT1;
+	case GL_COMPRESSED_RGBA_S3TC_DXT3_EXT:
+		*mesaFormat = &_mesa_texformat_rgba_dxt3;
+		return D3DFMT_DXT3;
+	case GL_COMPRESSED_RGBA_S3TC_DXT5_EXT:
+		*mesaFormat = &_mesa_texformat_rgba_dxt5;
+		return D3DFMT_DXT5;
+	}
+	*mesaFormat = NULL;
+	return D3DFMT_UNKNOWN;
+}
+
+//---------------------------------------------------------------------------
+
+static void _gldCopyS3TCBlocks(
+	IDirect3DTexture9 *pTex,
+	GLint level,
+	D3DFORMAT d3dFormat,
+	GLint xoffset,
+	GLint yoffset,
+	GLsizei width,
+	GLsizei height,
+	GLsizei imageSize,
+	const GLvoid *data)
+{
+	D3DLOCKED_RECT	lr;
+	RECT			rc;
+	const GLubyte	*src = (const GLubyte *)data;
+	int				blockBytes = (d3dFormat == D3DFMT_DXT1) ? 8 : 16;
+	int				blocksW = (width + 3) / 4;
+	int				blocksH = (height + 3) / 4;
+	int				rowBytes, y;
+
+	if (!pTex || !data || level >= (GLint)IDirect3DTexture9_GetLevelCount(pTex))
+		return;
+	if (blocksW < 1) blocksW = 1;
+	if (blocksH < 1) blocksH = 1;
+	rowBytes = blocksW * blockBytes;
+	if (imageSize < rowBytes * blocksH) {
+		gldLogPrintf(GLDLOG_WARN, "CompressedTexImage: %d bytes for %dx%d", imageSize, width, height);
+		return;
+	}
+	// Whole blocks only (as glCompressedTexSubImage2D requires)
+	SetRect(&rc, xoffset, yoffset, xoffset + blocksW * 4, yoffset + blocksH * 4);
+	{
+		D3DSURFACE_DESC d;
+		IDirect3DTexture9_GetLevelDesc(pTex, level, &d);
+		if (rc.right > (LONG)d.Width) rc.right = d.Width;
+		if (rc.bottom > (LONG)d.Height) rc.bottom = d.Height;
+	}
+	if (FAILED(IDirect3DTexture9_LockRect(pTex, level, &lr, &rc, 0)))
+		return;
+	for (y = 0; y < blocksH; y++)
+		memcpy((GLubyte *)lr.pBits + y * lr.Pitch, src + y * rowBytes, rowBytes);
+	IDirect3DTexture9_UnlockRect(pTex, level);
+}
+
+//---------------------------------------------------------------------------
+
+void gld_CompressedTexImage2D_DX9(
+	GLcontext *ctx,
+	GLenum target,
+	GLint level,
+	GLint internalFormat,
+	GLsizei width,
+	GLsizei height,
+	GLint border,
+	GLsizei imageSize,
+	const GLvoid *data,
+	struct gl_texture_object *tObj,
+	struct gl_texture_image *texImage)
+{
+	GLD_context			*gldCtx	= GLD_GET_CONTEXT(ctx);
+	GLD_driver_dx9		*gld	= GLD_GET_DX9_DRIVER(gldCtx);
+	IDirect3DTexture9	*pTex;
+	const struct gl_texture_format *mesaFormat;
+	D3DFORMAT			d3dFormat;
+
+	if (!tObj || !texImage)
+		return;
+	d3dFormat = _gldS3TCFormat(internalFormat, &mesaFormat);
+	if (d3dFormat == D3DFMT_UNKNOWN) {
+		_mesa_error(ctx, GL_INVALID_ENUM, "glCompressedTexImage2D(internalFormat)");
+		return;
+	}
+	texImage->TexFormat		= mesaFormat;
+	texImage->FetchTexel	= mesaFormat->FetchTexel2D;
+	texImage->IsCompressed	= GL_TRUE;
+	texImage->CompressedSize = imageSize;
+	if (target != GL_TEXTURE_2D)
+		return; // this driver draws 1D/2D textures only
+
+	pTex = (IDirect3DTexture9*)tObj->DriverData;
+	if (level == 0) {
+		// Keep the Direct3D texture only if it has the same size and format
+		if (pTex) {
+			D3DSURFACE_DESC d;
+			IDirect3DTexture9_GetLevelDesc(pTex, 0, &d);
+			if (d.Width != (UINT)width || d.Height != (UINT)height || d.Format != d3dFormat) {
+				tObj->DriverData = NULL;
+				IDirect3DTexture9_Release(pTex);
+				pTex = NULL;
+			}
+		}
+		if (!pTex) {
+			HRESULT hr = IDirect3DDevice9_CreateTexture(gld->pDev, width, height,
+				glb.bUseMipmaps ? 0 : 1, 0, d3dFormat, D3DPOOL_MANAGED, &pTex, NULL);
+			if (FAILED(hr)) {
+				gldLogError(GLDLOG_ERROR, "CompressedTexImage2D: CreateTexture", hr);
+				return;
+			}
+			tObj->DriverData = pTex;
+		}
+	}
+	if (!pTex)
+		return;
+	_gldCopyS3TCBlocks(pTex, level, d3dFormat, 0, 0, width, height, imageSize, data);
+}
+
+//---------------------------------------------------------------------------
+
+void gld_CompressedTexSubImage2D_DX9(
+	GLcontext *ctx,
+	GLenum target,
+	GLint level,
+	GLint xoffset,
+	GLint yoffset,
+	GLsizei width,
+	GLsizei height,
+	GLenum format,
+	GLsizei imageSize,
+	const GLvoid *data,
+	struct gl_texture_object *tObj,
+	struct gl_texture_image *texImage)
+{
+	IDirect3DTexture9	*pTex;
+	D3DSURFACE_DESC		d;
+
+	if (!tObj || target != GL_TEXTURE_2D)
+		return;
+	pTex = (IDirect3DTexture9*)tObj->DriverData;
+	if (!pTex || level >= (GLint)IDirect3DTexture9_GetLevelCount(pTex))
+		return;
+	IDirect3DTexture9_GetLevelDesc(pTex, level, &d);
+	if (d.Format != D3DFMT_DXT1 && d.Format != D3DFMT_DXT3 && d.Format != D3DFMT_DXT5)
+		return;
+	_gldCopyS3TCBlocks(pTex, level, d.Format, xoffset, yoffset, width, height, imageSize, data);
+}
+
