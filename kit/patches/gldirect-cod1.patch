 #endif
 
+	// Siliconium: direct glDrawElements (falls back to Mesa's loopback when it cannot)
+	vf->DrawElements			= d3dDrawElementsFast;
+
 	// Install our own vertexformat
 	_mesa_install_exec_vtxfmt(ctx, vf);
 
