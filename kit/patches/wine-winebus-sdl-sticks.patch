+
+/* SDL reports each changed axis separately. Deliver the first stick update
+ * immediately, then keep the newest state within the short report interval.
+ * Buttons and triggers bypass batching, including when a stick is pending. */
+static void queue_controller_report(struct sdl_device *impl, BOOL stick_event)
+{
+    struct unix_device *iface = &impl->unix_device;
+    struct hid_device_state *state = &iface->hid_device_state;
 
+    if (batch_sdl_sticks && stick_event)
+    {
+        UINT now = pSDL_GetTicks();
+        if (impl->stick_report_sent && now - impl->last_stick_report < SDL_STICK_REPORT_INTERVAL_MS)
+        {
+            impl->stick_report_pending = TRUE;
+            return;
+        }
+        impl->last_stick_report = now;
+        impl->stick_report_sent = TRUE;
+    }
+    impl->stick_report_pending = FALSE;
+    bus_event_queue_input_report(&event_queue, iface, state->report_buf, state->report_len);
+}
+
+static BOOL flush_pending_stick_reports(void)
+{
+    struct sdl_device *impl;
+    BOOL pending = FALSE;
+
+    if (!batch_sdl_sticks) return FALSE;
+    pthread_mutex_lock(&sdl_cs);
+    LIST_FOR_EACH_ENTRY(impl, &device_list, struct sdl_device, unix_device.entry)
+    {
+        if (!impl->stick_report_pending) continue;
+        queue_controller_report(impl, TRUE);
+        pending |= impl->stick_report_pending;
+    }
+    pthread_mutex_unlock(&sdl_cs);
+    return pending;
+}
