+/* Siliconium (SIL_HIDE_ON_DEACTIVATE=1): a fullscreen game hides itself when
+ * the player switches to another app, as Windows does on Alt-Tab and as Wine
+ * itself does on Cmd-Tab while the displays are captured (handleCommandTab:
+ * [NSApp hide:self]). Without display capture (so the screen can be recorded)
+ * the system handles Cmd-Tab, the game was only deactivated, and its black
+ * fullscreen window stayed on screen behind the other app. An outside helper
+ * cannot do it: NSRunningApplication -hide is refused for a UIElement app (the
+ * game bundle), while the app's own [NSApp hide:] works. macOS unhides the app
+ * when the player activates it again. Only when the app in front is a regular
+ * app (not Spotlight, Notification Center or a system prompt), only for a
+ * window that covers a screen, and not in the first seconds after the game
+ * came to the front (a game hidden while it starts can freeze). */
+static BOOL hide_on_deactivate(void)
+{
+    static dispatch_once_t once;
+    static BOOL enabled;
+
+    dispatch_once(&once, ^{
+        const char *value = getenv("SIL_HIDE_ON_DEACTIVATE");
+        enabled = value && !strcmp(value, "1");
+    });
+    return enabled;
+}
+
+static CFAbsoluteTime sil_active_since;
+
+/* Siliconium (SIL_HIDE_ON_DEACTIVATE=1): set when the player leaves the app
+ * for another one (Cmd-Tab, a click, the Dock) and cleared when the app is
+ * active again. Meanwhile the app neither activates itself
+ * (tryToActivateIgnoringOtherApps:) nor unhides itself (orderBelow:orAbove:
+ * activate:, cocoa_window.m): as Windows' foreground lock, a program the
+ * player left cannot take the foreground back; only the player (or macOS on
+ * their behalf) brings it back. Whatever the game does with its window when
+ * it loses the focus (fullscreen, fullscreen window or windowed; minimize,
+ * re-show, re-enter fullscreen) cannot pull it in front again. Black Ops II,
+ * 2026-11-24, after the player switched its display mode in its options:
+ * each Cmd-Tab out was followed 17-29 ms later by the game in front again
+ * (launchservicesd SETFRONT), and back from the next one it took no click
+ * until another Cmd-Tab. NSApp's unhide: also activates the app. */
+BOOL sil_left_by_player;
+
+/* Siliconium (SIL_DISPLAYMODE_RECORD = the record of launch.sh's display mode
+ * hold, tools/displaymode: the desktop's mode ID, then the 1x mode ID held
+ * while the game runs): while the game is hidden behind another app the
+ * desktop gets its own mode back (HiDPI), and the game's 1x mode returns when
+ * the game is active again. Only when the hold switched modes (the record is
+ * there), only after this process hid the game, and only from the mode we
+ * expect (a mode the player chose meanwhile is left alone). */
+static BOOL sil_switched_to_desktop;
+
+static CGDisplayModeRef sil_copy_mode_with_id(CGDirectDisplayID display, int32_t mode_id)
+{
+    const void *keys[] = { kCGDisplayShowDuplicateLowResolutionModes };
+    const void *values[] = { kCFBooleanTrue };
+    CFDictionaryRef options = CFDictionaryCreate(NULL, keys, values, 1, &kCFTypeDictionaryKeyCallBacks,
+                                                 &kCFTypeDictionaryValueCallBacks);
+    CFArrayRef modes = CGDisplayCopyAllDisplayModes(display, options);
+    CGDisplayModeRef found = NULL;
+    CFIndex i;
+
+    if (options) CFRelease(options);
+    if (!modes) return NULL;
+    for (i = 0; i < CFArrayGetCount(modes); i++)
+    {
+        CGDisplayModeRef mode = (CGDisplayModeRef)CFArrayGetValueAtIndex(modes, i);
+        if (CGDisplayModeGetIODisplayModeID(mode) == mode_id)
+        {
+            found = CGDisplayModeRetain(mode);
+            break;
+        }
+    }
+    CFRelease(modes);
+    return found;
+}
+
+static void sil_desktop_mode_while_away(BOOL away)
+{
+    const char *path = getenv("SIL_DISPLAYMODE_RECORD");
+    CGDirectDisplayID display = CGMainDisplayID();
+    CGDisplayModeRef current, target;
+    int32_t desktop_id = 0, held_id = 0, from, to;
+    CGDisplayConfigRef config;
+    FILE *f;
+
+    if (!path || !*path) return;
+    if (!away && !sil_switched_to_desktop) return;
+    sil_switched_to_desktop = FALSE;
+    if (!(f = fopen(path, "r"))) return;   /* no hold (or it ended): nothing to do */
+    if (fscanf(f, "%d %d", &desktop_id, &held_id) != 2) desktop_id = held_id = 0;
+    fclose(f);
+    if (!desktop_id || !held_id || desktop_id == held_id) return;
+    from = away ? held_id : desktop_id;
+    to = away ? desktop_id : held_id;
+    if (!(current = CGDisplayCopyDisplayMode(display))) return;
+    if (CGDisplayModeGetIODisplayModeID(current) != from)
+    {
+        CGDisplayModeRelease(current);
+        return;
+    }
+    CGDisplayModeRelease(current);
+    if (!(target = sil_copy_mode_with_id(display, to))) return;
+    if (CGBeginDisplayConfiguration(&config) == kCGErrorSuccess)
+    {
+        CGConfigureDisplayWithDisplayMode(config, display, target, NULL);
+        if (CGCompleteDisplayConfiguration(config, kCGConfigureForSession) == kCGErrorSuccess && away)
+            sil_switched_to_desktop = TRUE;
+    }
+    CGDisplayModeRelease(target);
+}
+
+static BOOL sil_capture_ui_active(void)
+{
+    NSArray<NSRunningApplication*>* apps =
+        [NSRunningApplication runningApplicationsWithBundleIdentifier:@"com.apple.screencaptureui"];
+    return [apps count] > 0;
+}
+
+static BOOL sil_is_system_overlay(NSRunningApplication* front)
+{
+    NSString* bid;
+    if (!front) return YES;
+    if (front.activationPolicy != NSApplicationActivationPolicyRegular) return YES;
+    bid = front.bundleIdentifier;
+    if (!bid) return NO;
+    return [bid isEqualToString:@"com.apple.screencaptureui"] ||
+           [bid isEqualToString:@"com.apple.screenshot.launcher"] ||
+           [bid isEqualToString:@"com.apple.Screenshot"] ||
+           [bid isEqualToString:@"com.apple.ScreenContinuity"] ||
+           [bid isEqualToString:@"com.apple.controlcenter"] ||
+           [bid isEqualToString:@"com.apple.notificationcenterui"] ||
+           [bid isEqualToString:@"com.apple.Spotlight"];
+}
+
+static void sil_hide_if_other_app_in_front(int tries)
+{
+    NSRunningApplication* front;
+    NSWindow* window;
+    BOOL fullscreen = FALSE;
+
+    if ([NSApp isActive] || [NSApp isHidden]) return;
+    if (sil_capture_ui_active()) return;
+    front = [[NSWorkspace sharedWorkspace] frontmostApplication];
+    if (!front || [front isEqual:[NSRunningApplication currentApplication]])
+    {
+        /* the system has not named the new app yet */
+        if (tries > 0)
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                sil_hide_if_other_app_in_front(tries - 1);
+            });
+        return;
+    }
+    if (sil_is_system_overlay(front)) return;
+    sil_left_by_player = TRUE;
+    for (window in [NSApp windows])
+    {
+        if ([window isKindOfClass:[WineWindow class]] && ((WineWindow*)window).fullscreen &&
+            [window isVisible] && ![window isMiniaturized])
+        {
+            fullscreen = TRUE;
+            break;
+        }
+    }
+    if (!fullscreen) return;
+    [NSApp hide:nil];
+    sil_desktop_mode_while_away(TRUE);
 }
 
