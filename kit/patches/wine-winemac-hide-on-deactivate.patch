  *
  * Handler for APP_ACTIVATED events.
  */
+/* Siliconium (SIL_HIDE_ON_DEACTIVATE=1, every game Siliconium starts): restore
+ * and give foreground back to the game's window in its own thread when macOS
+ * activates the app — including when a game started in the background and
+ * minimized itself before ever becoming active (e.g. WaW at 160x31). */
 void macdrv_app_activated(void)
 {
+    HWND hwnd = sil_left_foreground ? sil_left_foreground : sil_last_main_window, fg;
+
     TRACE("\n");
     macdrv_UpdateClipboard();
+
+    if (!hwnd || !sil_restore_foreground()) return;
+    if (!NtUserIsWindow(hwnd) || NtUserGetWindowThread(hwnd, NULL) != GetCurrentThreadId()) return;
+    if (hwnd == sil_left_foreground) sil_left_foreground = 0;
+    fg = NtUserGetForegroundWindow();
+    if (fg && fg != NtUserGetDesktopWindow() && !(NtUserGetWindowLongW(fg, GWL_STYLE) & WS_MINIMIZE)) return;   /* the player clicked one already */
+    if (!(NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_VISIBLE)) return;
+    if (NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_MINIMIZE)
+    {
+        TRACE("restoring %p left minimized\n", hwnd);
+        send_message(hwnd, WM_SYSCOMMAND, SC_RESTORE, 0);
+    }
+    if (NtUserIsWindow(hwnd) && NtUserGetForegroundWindow() != hwnd)
+    {
+        TRACE("giving the foreground back to %p\n", hwnd);
+        NtUserSetForegroundWindowInternal(hwnd);
+    }
 }
 
 
